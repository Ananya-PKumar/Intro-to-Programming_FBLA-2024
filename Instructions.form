            </Property>
            <Property name="text" type="java.lang.String" value="Welcome to the GPA Calculator!"/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="overviewSubTitle">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan Light" size="30" style="1"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value="Overview"/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="overviewInfo1">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan" size="20" style="0"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value="Under the &quot;Course Names&quot; header, notice how the course names are already provided for you; however, you can modify them at any time."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="overviewInfo2">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan" size="20" style="0"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value="*Just delete the provided course names in the text box and type-in your desired name. "/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="overviewInfo3">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan" size="20" style="0"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value="*Please note that course names have no affect on your GPA."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="overviewInfo4">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan" size="20" style="0"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value="To calculate your GPA, select the letter grade you received for a class in each of the seven dropdown menus below the header &quot;Course Name&quot; (Ex: A+, B)."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="overviewInfo5">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan" size="20" style="0"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value=" *You must select a grade for all seven of your courses before hitting the &quot;Calculate GPA&quot; button, or you GPA will be incorrectly calculated."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="overviewInfo6">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan" size="20" style="0"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value=" Once you click, the &quot;Calculate GPA&quot; button, your unweighted and weighted GPA will shift from the preset value of &apos;0.00&apos;.  "/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="overviewInfo7">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan" size="20" style="0"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value="*These are located to the right of your screen."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="overviewInfo8">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan" size="20" style="0"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value="Furthermore, under the header  &quot;Course Type&quot;, you can select the course type of your classes (Ex: Regular, AP, Honors)."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="overviewInfo9">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan" size="20" style="0"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value="*Note that the course type for all seven of your classes are preset to &quot;Regular&quot;."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="finalNotesSubTitle">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan Light" size="30" style="1"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value="Final Notes"/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="finalNotesInfo1">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan" size="20" style="0"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value="- Note, if you are taking all regular courses, your weighted and unweighted GPA will be the exact same."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="finalNotesInfo2">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan" size="20" style="0"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value="-Remember: Unweighted GPA does not take into account of what your course type is, and it is graded on a 0-4.5 scale."/>
          </Properties>
        </Component>
        <Component class="javax.swing.JLabel" name="finalNotesInfo3">
          <Properties>
            <Property name="font" type="java.awt.Font" editor="org.netbeans.beaninfo.editors.FontEditor">
              <Font name="HP Simplified Jpan" size="20" style="0"/>
            </Property>
            <Property name="foreground" type="java.awt.Color" editor="org.netbeans.beaninfo.editors.ColorEditor">
              <Color blue="ff" green="ff" red="ff" type="rgb"/>
            </Property>
            <Property name="text" type="java.lang.String" value="Weighted GPA includes your course type and is scaled from 0-5.5. "/>
          </Properties>
        </Component>
